# ============================================
# Vehicle Skills 特定忽略规则
# ============================================

# 生成的输出文件（这些应该由用户生成，不应提交到Git）
*_output/
*.db
*.db-journal
*_data.json
*_summary.xlsx
*.xlsx~  # Excel临时文件
error_report.md
processing.log

# 但保留references目录下的示例Excel文件
!references/*.xlsx

# 处理缓存
.cache/
*.pickle
*.pkl

# 日志文件
logs/
*.log
log.txt

# 测试生成的临时文件
test_output/
temp/
tmp/

# IDE配置
.vscode/
.idea/
*.swp
*.swo
*~

# 系统文件
.DS_Store
Thumbs.db

# 备份文件
*.bak
*.backup
*.old

# 敏感信息（如果存在）
*.pem
*.key
secrets.yaml
config.local.yaml

# 大数据文件（如果有）
*.tar.gz
*.zip
*.rar
data/raw/*
!data/raw/.gitkeep

# 性能分析文件
*.prof
profile_stats/
